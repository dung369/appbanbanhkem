rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Only authenticated admin can create, update, delete products
      allow create, update, delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // Orders collection
    match /orders/{orderId} {
      // Users can read their own orders
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == "trandaidung9a1@gmail.com");
      
      // Authenticated users can create orders
      allow create: if request.auth != null;
      
      // Only admin can update/delete orders
      allow update, delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "trandaidung9a1@gmail.com");
      
      // Users can create/update their own data
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Only admin can delete users
      allow delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // Cart collection
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // === CHATBOT SYSTEM COLLECTIONS ===
    
    // Chat Sessions - Allow guest users
    match /chat_sessions/{sessionId} {
      // Admin can read all sessions, users can read their own
      allow read: if request.auth != null && 
        (request.auth.token.email == "trandaidung9a1@gmail.com" || 
         resource.data.userId == request.auth.uid);
      
      // Anyone can create chat sessions (including guests)
      allow create: if true;
      
      // Users can update their own sessions, admin can update/delete all
      allow update, delete: if resource.data.userId == request.auth.uid || 
         (request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com");
    }
    
    // Chat Messages - Allow guest users
    match /chat_messages/{messageId} {
      // Anyone can read messages (simplified for chatbot)
      allow read: if true;
      
      // Anyone can create messages (including bots and guests)
      allow create: if true;
      
      // Only admin can update/delete messages
      allow update, delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // FAQ Collection
    match /faq/{faqId} {
      // Anyone can read FAQ
      allow read: if true;
      
      // Only admin and CSKH can manage FAQ
      allow create, update, delete: if request.auth != null && 
        (request.auth.token.email == "trandaidung9a1@gmail.com" ||
         get(/databases/$(database)/documents/cskh_users/$(request.auth.uid)).data.role in ['cskh', 'admin']);
    }
    
    // Knowledge Base
    match /knowledge_base/{kbId} {
      // Anyone can read active knowledge base items
      allow read: if resource.data.status == 'active' || 
        request.auth.token.email == "trandaidung9a1@gmail.com";
      
      // Only admin can manage knowledge base
      allow create, update, delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // User Membership
    match /user_membership/{userId} {
      // Users can read their own membership
      allow read: if request.auth != null && 
        (request.auth.uid == userId || request.auth.token.email == "trandaidung9a1@gmail.com");
      
      // Only system (admin) can create/update membership
      allow create, update: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // User Usage Tracking (for rate limiting)
    match /user_usage/{usageId} {
      // Users can read their own usage
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.email == "trandaidung9a1@gmail.com");
      
      // System can create/update usage
      allow create, update: if request.auth != null;
    }
    
    // CSKH Users
    match /cskh_users/{cskhId} {
      // CSKH and admin can read all CSKH users
      allow read: if request.auth != null && 
        (request.auth.token.email == "trandaidung9a1@gmail.com" ||
         get(/databases/$(database)/documents/cskh_users/$(request.auth.uid)).data.role in ['cskh', 'admin']);
      
      // Only admin can manage CSKH users
      allow create, update, delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // Notifications
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // System and admin can create notifications
      allow create: if request.auth != null;
      
      // Users can update their own notifications (mark as read)
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Only admin can delete notifications
      allow delete: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // System Configuration
    match /system_config/{configId} {
      // Anyone can read system config
      allow read: if true;
      
      // Only admin can update config
      allow update: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
    
    // Chat Statistics
    match /chat_statistics/{statId} {
      // Admin and CSKH can read statistics
      allow read: if request.auth != null && 
        (request.auth.token.email == "trandaidung9a1@gmail.com" ||
         get(/databases/$(database)/documents/cskh_users/$(request.auth.uid)).data.role in ['cskh', 'admin']);
      
      // Only admin can write statistics
      allow write: if request.auth != null && request.auth.token.email == "trandaidung9a1@gmail.com";
    }
  }
}
